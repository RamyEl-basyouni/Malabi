# ============================
# UNIFIED GITIGNORE FOR BOTH PROJECTS
# React Native (MalaabyApp) + NestJS (malaaby-backend)
# ============================

# ============================
# Node.js & Dependencies
# ============================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Package manager files
package-lock.json
yarn.lock
pnpm-lock.yaml

# ============================
# Build & Compiled Output
# ============================
# NestJS backend
/malaaby-backend/dist/
/malaaby-backend/build/

# React Native / Expo
/MalaabyApp/.expo/
/MalaabyApp/dist/
/MalaabyApp/build/
/MalaabyApp/web-build/

# General build directories
build/
dist/
out/
.next/
.nuxt/

# ============================
# Environment Variables
# ============================
.env
.env.*
!.env.example

# ============================
# Database Files
# ============================
*.db
*.sqlite
*.sqlite3
/malaaby-backend/malaaby.db

# ============================
